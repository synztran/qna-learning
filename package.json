{
  "name": "qna-learning-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@qna/web",
    "dev:admin": "turbo run dev --filter=@qna/admin",
    "db:seed": "pnpm --filter=@qna/database db:seed",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.29.2"
}
